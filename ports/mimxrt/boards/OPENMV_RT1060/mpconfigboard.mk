MCU_SERIES = MIMXRT1062
MCU_VARIANT = MIMXRT1062DVJ6A

MICROPY_FLOAT_IMPL = single
MICROPY_HW_FLASH_TYPE = qspi_nor_flash
MICROPY_HW_FLASH_SIZE = 0x1000000   # 16MB
MICROPY_HW_FLASH_CLK = kFlexSpiSerialClk_133MHz
MICROPY_HW_FLASH_QE_CMD = 0x01
MICROPY_HW_FLASH_QE_ARG = 0x40
MICROPY_HW_ROMFS_BYTES = 0x800000  # 8MB

# The firmware sits behind the OpenMV bootloader, and the filesystem and ROMFS
# are where the OpenMV firmware puts them.
LD_FILES = boards/OPENMV_RT1060/board.ld boards/common.ld

MICROPY_HW_SDRAM_AVAIL = 1
MICROPY_HW_SDRAM_SIZE  = 0x2000000  # 32MB

MICROPY_PY_MACHINE_SDCARD ?= 1
MICROPY_PY_LWIP = 1
MICROPY_PY_SSL = 1
MICROPY_SSL_MBEDTLS = 1
MICROPY_PY_NETWORK_CYW43 = 1
# The Ethernet PHY is a KSZ8081RND.
MICROPY_PY_NETWORK_PHYKSZ8081RND = 1
MICROPY_PY_BLUETOOTH = 1
MICROPY_BLUETOOTH_NIMBLE = 1
MICROPY_BLUETOOTH_BTSTACK = 0

FROZEN_MANIFEST ?= $(BOARD_DIR)/manifest.py
