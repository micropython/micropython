From e5874038bf3cd7adc1542dbd90f1285de568bafd Mon Sep 17 00:00:00 2001
From: root <root@ubuntu>
Date: Fri, 6 Nov 2026 11:18:33 +0800
Subject: [PATCH] dwc2: add GD32F4 (Cortex-M4) USBFS support

The existing GD32 port targets the GD32VF103 RISC-V part, whose DWC2
integration uses the RISC-V ECLIC for interrupt routing.  GD32F4 is a
Cortex-M4 with the same DWC2 core but a different interrupt controller, so
it needs its own controller description.

- dwc2_gd32f4.h: controller at 0x5000_0000, 4 endpoints, 320-word DFIFO,
  interrupt routed through the NVIC using USBFS_IRQn.
- tusb_option.h: OPT_MCU_GD32F4 (1601).
- tusb_mcu.h: GD32F4 selects TUP_USBIP_DWC2 with 4 endpoints.
- dwc2_common.h: pick dwc2_gd32f4.h for OPT_MCU_GD32F4.
---
 src/common/tusb_mcu.h                    |  3 +
 src/portable/synopsys/dwc2/dwc2_common.h |  2 +
 src/portable/synopsys/dwc2/dwc2_gd32f4.h | 81 ++++++++++++++++++++++++
 src/tusb_option.h                        |  1 +
 4 files changed, 87 insertions(+)
 create mode 100644 src/portable/synopsys/dwc2/dwc2_gd32f4.h

diff --git a/src/common/tusb_mcu.h b/src/common/tusb_mcu.h
index 35de47030..a5cba043f 100644
--- a/src/common/tusb_mcu.h
+++ b/src/common/tusb_mcu.h
@@ -548,6 +548,9 @@
 //--------------------------------------------------------------------+
 // GigaDevice
 //--------------------------------------------------------------------+
+#elif TU_CHECK_MCU(OPT_MCU_GD32F4)
+  #define TUP_USBIP_DWC2
+  #define TUP_DCD_ENDPOINT_MAX 4
 #elif TU_CHECK_MCU(OPT_MCU_GD32VF103)
   #define TUP_USBIP_DWC2
   #define TUP_DCD_ENDPOINT_MAX 4
diff --git a/src/portable/synopsys/dwc2/dwc2_common.h b/src/portable/synopsys/dwc2/dwc2_common.h
index 5c4798d21..17cf73077 100644
--- a/src/portable/synopsys/dwc2/dwc2_common.h
+++ b/src/portable/synopsys/dwc2/dwc2_common.h
@@ -52,6 +52,8 @@
   #include "dwc2_stm32.h"
 #elif defined(TUP_USBIP_DWC2_ESP32)
   #include "dwc2_esp32.h"
+#elif TU_CHECK_MCU(OPT_MCU_GD32F4)
+  #include "dwc2_gd32f4.h"
 #elif TU_CHECK_MCU(OPT_MCU_GD32VF103)
   #include "dwc2_gd32.h"
 #elif TU_CHECK_MCU(OPT_MCU_BCM2711, OPT_MCU_BCM2835, OPT_MCU_BCM2837)
diff --git a/src/portable/synopsys/dwc2/dwc2_gd32f4.h b/src/portable/synopsys/dwc2/dwc2_gd32f4.h
new file mode 100644
index 000000000..ba831d62b
--- /dev/null
+++ b/src/portable/synopsys/dwc2/dwc2_gd32f4.h
@@ -0,0 +1,81 @@
