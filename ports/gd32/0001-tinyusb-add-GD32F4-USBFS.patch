+#ifndef DWC2_GD32F4_H_
+#define DWC2_GD32F4_H_
+
+#ifdef __cplusplus
+ extern "C" {
+#endif
+
+// GD32F4 (Cortex-M4) USBFS controller.
+// This is a Synopsys DWC2 core at 0x5000_0000 with 4 IN/OUT endpoints and a
+// dedicated 320-word data FIFO.  Unlike the GD32VF103 port this is an ARM
+// target, so interrupts use the NVIC rather than the RISC-V ECLIC.
+//
+// The GD32 CMSIS device header is required here for IRQn_Type, NVIC_EnableIRQ
+// and the USBFS_IRQn enumerator.
+#include "gd32f4xx.h"
+
+#define DWC2_REG_BASE       0x50000000UL
+#define DWC2_EP_MAX         4
+#define DWC2_DFIFO_DEPTH    320
+
+// IRQ number from the GD32F4 vector table (gd32f4xx.h: USBFS_IRQn = 67).
+#define DWC2_USBFS_IRQn     ((IRQn_Type) USBFS_IRQn)
+
+static const dwc2_controller_t _dwc2_controller[] =
+{
+  { .reg_base = DWC2_REG_BASE, .irqnum = (int) DWC2_USBFS_IRQn,
+    .ep_count = DWC2_EP_MAX, .otg_dfifo_depth = DWC2_DFIFO_DEPTH }
+};
+
+// ARM target: route the controller interrupt through the NVIC.
+static inline void dwc2_dcd_int_enable(uint8_t rhport) {
+  (void) rhport;
+  NVIC_SetPriority(DWC2_USBFS_IRQn, 2);
+  NVIC_EnableIRQ(DWC2_USBFS_IRQn);
+}
+
+static inline void dwc2_dcd_int_disable(uint8_t rhport) {
+  (void) rhport;
+  NVIC_DisableIRQ(DWC2_USBFS_IRQn);
+}
+
+static inline void dwc2_remote_wakeup_delay(void) {
+  // Not required for this controller.
+}
+
+// The MCU itself is brought up by the port (clock + pin muxing) before
+// tusb_init() runs, so there is nothing to do here.
+static inline void dwc2_mcu_init(void) {
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/tusb_option.h b/src/tusb_option.h
index b23b37467..a84a776a4 100644
--- a/src/tusb_option.h
+++ b/src/tusb_option.h
@@ -165,6 +165,7 @@
 #define OPT_MCU_MM32F327X        1500 ///< Mind Motion MM32F327
 
 // GigaDevice
+#define OPT_MCU_GD32F4           1601 ///< GigaDevice GD32F4 (Cortex-M4, USBFS DWC2)
 #define OPT_MCU_GD32VF103        1600 ///< GigaDevice GD32VF103
 
 // Broadcom
