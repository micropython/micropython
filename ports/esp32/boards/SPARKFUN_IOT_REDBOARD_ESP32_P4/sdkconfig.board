# Most settings are in sdkconfig.p4_wifi_common.
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y

# The SparkFun board uses different SDIO pins than other boards. In order to
# change them, the dev board must be "none".
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y

# Specify the SDIO pins.
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=17
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=18

# Also specify the reset pin, which is active low on this board.
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=20
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
