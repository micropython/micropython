/ {
	chosen {
		/* Use USB CDC ACM as the console. */
		zephyr,console = &cdc_acm_uart0;
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/flash";
			partition = <&storage_partition>;
			read-size=<16>;
			prog-size=<256>;
			cache-size=<1024>;
			lookahead-size=<32>;
			block-cycles=<4>;
		};
	};

	gpio0_related {
		compatible = "micropython,related-pins-integer-generator";
		gpio-device = <&gpio0>;
		gpio-micropython-ranges = <0 30>;
		gpio-zephyr-ranges = <0 30>;
	};

	named_related_0 {
		compatible = "micropython,related-pins-arbitrary";
		gpio-device = <&gpio0>;
		gpio-micropython-strings = "ADC0", "ADC1", "ADC2", "ADC3";
		gpio-zephyr-ids = <26 27 28 29>;
	};

	named_related_wl {
		compatible = "micropython,related-pins-arbitrary";
		gpio-device = <&cyw43_gpio>;
		gpio-micropython-strings = "LED", "led";
		gpio-zephyr-ids = <0>, <0>;
	};
};

/delete-node/ &code_partition;
&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		code_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "code";
			reg = <0x0000000 (DT_SIZE_M(1))>;
			read-only;
		};

		storage_partition: partition@100000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x00100000 DT_SIZE_M(3)>;
		};
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&i2c1 {
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};


&uart0 {
	status = "okay";
	current-speed = <115200>;
	zephyr,deferred-init;
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_P4>;
		};
		group2 {
			pinmux = <UART1_RX_P5>;
			input-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	zephyr,deferred-init;
	/* A pinctrl struct MUST have been allocated at build time to use dynamic pinctrl,
	 * but it can be nonsense if needed as the device is deferred-init
	 * and pinctrl won't be applied until device init.
	 */
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";

};

&i2c0 {
	status = "okay";
	zephyr,deferred-init;
};

&spi0 {
	status = "okay";
	zephyr,deferred-init;
};

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			pinmux = <SPI1_TX_P11>, <SPI1_CSN_P13>, <SPI1_SCK_P14>;
		};
		group2 {
			pinmux = <SPI1_RX_P12>;
			input-enable;
		};
	};
};

&spi1 {
	status = "okay";
	zephyr,deferred-init;
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
};
