/ {
	fstab {
		compatible = "zephyr,fstab";
		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/flash";
			partition = <&storage_partition>;
			read-size=<16>;
			prog-size=<256>;
			cache-size=<1024>;
			lookahead-size=<32>;
			block-cycles=<4>;
		};
	};
};

&wdt0 {
	status = "okay";
};

/delete-node/ &slot0_partition;
/delete-node/ &storage_partition;

&gd25lq32d {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@2000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00002000 (0x00200000 - 0x2000)>;
			read-only;
		};

		storage_partition: partition@200000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x00200000 0x200000>;
		};
	};
};

/* Fit envelope better to actual wireless RAM usage
 * BLE takes off 32KB off WRAM
 * Additionally, wifi picks about 68KB of uncached WRAM
 */

&all_ram {
	reg = <0x62fc0000 DT_SIZE_K(380)>;
	ranges = <0x0 0x62fc0000 DT_SIZE_K(380)>;
};

&wifi_ram {
	/* 0x22fc0000 + all_ram */
	reg = <0x2301f000 DT_SIZE_K(68)>;
	ranges = <0x0 0x2301f000 DT_SIZE_K(68)>;
};
