		DT_HAS_INFINEON_XMC4XXX_ETHERNET_ENABLED || \
		DT_HAS_INTEL_E1000_ENABLED || \
		DT_HAS_LITEX_LITEETH_ENABLED || \
		DT_HAS_MICROCHIP_ENC28J60_ENABLED || \
		DT_HAS_MICROCHIP_ENC424J600_ENABLED || \
		DT_HAS_MICROCHIP_LAN865X_ENABLED || \
		DT_HAS_MICROCHIP_LAN9250_ENABLED || \
		DT_HAS_NUVOTON_NUMAKER_ETHERNET_ENABLED || \
		DT_HAS_NXP_ENET_ENABLED || \
		DT_HAS_NXP_ENET_MAC_ENABLED || \
		DT_HAS_NXP_ENET_QOS_ENABLED || \
		DT_HAS_NXP_ENET_QOS_MAC_ENABLED || \
		DT_HAS_NXP_S32_GMAC_ENABLED || \
		DT_HAS_RENESAS_RA_ETHERNET_ENABLED || \
		DT_HAS_SENSRY_SY1XX_MAC_ENABLED || \
		DT_HAS_SIEMENS_IVSHMEM_ETH_ENABLED || \
