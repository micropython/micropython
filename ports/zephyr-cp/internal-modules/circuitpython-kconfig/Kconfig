# CircuitPython defaults that must merge before Zephyr's subsystem Kconfig
# files.
#
# Zephyr merges this file via its module mechanism (Kconfig.zephyr sources
# "modules/Kconfig", which pulls in every module's Kconfig) right after the
# SoC/board defconfigs and BEFORE kernel/, drivers/, lib/ and subsys/. Kconfig
# takes the first `default` it sees for a symbol, so defaults defined here win
# over the ones Zephyr's own subsystem Kconfigs define later.
#
# These same defaults must NOT live in the application Kconfig
# (ports/zephyr-cp/Kconfig): it is sourced after all of Zephyr, so any symbol
# Zephyr gives a (conditional) default of its own would silently shadow the
# port's value there. Examples that were shadowed here before this module
# existed: BT_BUF_* (Zephyr defaults them for BT_CLASSIC/BT_MESH/... boards),
# BT_DEVICE_NAME_MAX, BT_L2CAP_TX_MTU, MCUMGR_TRANSPORT_NETBUF_SIZE.
#
# Boards can override any of these in their boards/<vendor>/<board>/board.conf.

# ===== Peripheral defaults — enabled by default, boards can disable =====

config I2C
	default y

config SPI
	default y

config SPI_ASYNC
	default y

config I2S
	default y

config UART_LINE_CTRL
	default y

config ENTROPY_GENERATOR
	default y

# ===== Dynamic pin routing (nRF) =====
# CircuitPython routes peripherals to pins at runtime on nRF SoCs. That needs
# pinctrl states to be swappable (PINCTRL_DYNAMIC) and devices to be
# de-initializable/re-initializable (DEVICE_DEINIT_SUPPORT). Both cost a little
# RAM (pinctrl configs move out of flash) and one function pointer per device.
config PINCTRL_DYNAMIC
	default y if SOC_FAMILY_NORDIC_NRF

config DEVICE_DEINIT_SUPPORT
	default y if SOC_FAMILY_NORDIC_NRF

# ===== Interrupt locking versus the Bluetooth controller (nRF) =====
# CircuitPython cannot bound its critical sections (bitbangio, onewireio, user
# code calling disable_interrupts(), the neopixel_write bit-bang fallback).
#
# Let the controller's radio interrupts (BT_CTLR_ZLI, default on) bypass
# irq_lock(), as the SoftDevice's interrupts do in ports/nordic.
config ZERO_LATENCY_IRQS
	default y if SOC_FAMILY_NORDIC_NRF

# The upper link layer schedules each radio event from an ordinary interrupt
# and the controller allows 733 us (EVENT_OVERHEAD_START_US) for that to run.
# Zephyr's default makes a longer delay a fatal assertion that halts the
# system; with the assertion off the controller skips the delayed radio event
# instead, which is the behavior we want.
config BT_CTLR_ASSERT_OVERHEAD_START
	default n if SOC_FAMILY_NORDIC_NRF

# ===== Flash filesystem scratch page =====
# supervisor/flash.c caches the erase page being written in RAM. With a
# scratch page, it allocates the cache only while writing, and stages writes
# in the last erase page of the filesystem when it can't. Without one, it
# allocates the cache once at startup and keeps it, and the filesystem gets
# the whole partition.
#
# ports/raspberrypi caches one 4 KB sector in a static buffer and reserves no
# scratch page, so do the same on RP2040 and RP2350: the filesystem sizes
# then match, and either port can use a filesystem formatted by the other.
config CIRCUITPY_FLASH_SCRATCH_PAGE
	bool "Stage flash writes in a scratch page when the RAM cache can't be allocated"
	default n if SOC_FAMILY_RPI_PICO
	default y

# ===== Zephyr malloc arena reserve =====
# The VM heap grows into Zephyr's malloc arena, but Zephyr also allocates from
# the arena for BLE and TLS, on its own threads, which can't use the GC heap.
# port_heap_get_largest_free_size() leaves this many bytes of the arena for
# them. Without a reserve, a full VM heap makes BLE pairing fail.
config CIRCUITPY_ZEPHYR_MALLOC_RESERVE
	int "Bytes of Zephyr's malloc arena the VM heap leaves free"
	depends on COMMON_LIBC_MALLOC
	default 4096

# ===== External NOR flash =====
# supervisor/flash.c sets aside the last erase page of the filesystem as a
# scratch page, and caches a whole erase page in RAM while writing. The NOR
# flash drivers' default layout page is the 64 KB erase block, which loses
# 64 KB of the filesystem and needs a 64 KB RAM cache. Use the 4 KB sector
# instead; the drivers erase 4 KB sectors too. Changing one block then
# rewrites 4 KB instead of 64 KB, which is faster for small writes such as
# FAT updates. Filesystem partitions also start and end on 4 KB boundaries,
# but not always on 64 KB ones.
#
# On nRF QSPI boards, the filesystem size then matches ports/nordic, so
# either port can use a filesystem formatted by the other.
config NORDIC_QSPI_NOR_FLASH_LAYOUT_PAGE_SIZE
	default 4096 if NORDIC_QSPI_NOR

config SPI_NOR_FLASH_LAYOUT_PAGE_SIZE
	default 4096 if SPI_NOR

config FLASH_MSPI_NOR_LAYOUT_PAGE_SIZE
	default 4096 if FLASH_MSPI_NOR

