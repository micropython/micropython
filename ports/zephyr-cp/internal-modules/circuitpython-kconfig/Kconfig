config NETWORKING
	default y if ZCP_ETHERNET_DT

config NET_L2_ETHERNET
	default y if ZCP_ETHERNET_DT

config NET_IPV4
	default y if ZCP_ETHERNET_DT

config NET_DHCPV4
	default y if ZCP_ETHERNET_DT

config NET_SOCKETS
	default y if ZCP_ETHERNET_DT

config NET_MGMT_EVENT
	default y if ZCP_ETHERNET_DT

config NET_MGMT_EVENT_INFO
	default y if ZCP_ETHERNET_DT

config HEAP_MEM_POOL_SIZE
	default 4096 if ZCP_ETHERNET_DT

# getaddrinfo() resolves hostnames through Zephyr's DNS resolver. Without it,
# the resolver symbols stay invisible and only literal IP addresses resolve;
# every hostname lookup returns DNS_EAI_NONAME ("Name or service not known").
# DHCP feeds the resolver the DNS server from its lease via
# NET_DHCPV4_OPTION_DNS_ADDRESS (default y once DNS_RESOLVER is on). Boards
# can turn it off with CONFIG_DNS_RESOLVER=n in board.conf.
config DNS_RESOLVER
	default y if NETWORKING

# Every SOCK_STREAM socket, from the connection manager to the web workflow
# listener, needs the TCP stack. NETWORKING + NET_SOCKETS only give UDP until
# this is set: socketpool raises "Out of sockets" (because zsock_socket()
# fails with -EPFNOSUPPORT) for every TCP attempt. Silabs documented the same
# gap for its native-stack board, so default it on for every networked board.
config NET_TCP
	default y if NETWORKING

# Zephyr's 2 s DNS window gives exactly one query: the first lookup right
# after a boot (when the resolver just learned its server and the APR entry
# may not exist yet) gets cancelled outright, reported as DNS_EAI_CANCELED
# (-101). 10 s with 5 s backoff gives every lookup one retry.
config NET_SOCKETS_DNS_TIMEOUT
	default 10000 if DNS_RESOLVER

# The ENET-QoS RX thread's Zephyr default stack of 1024 bytes barely fits the
# driver, and overflows once the network stack logs (the packet-trace DBG
# lines in net_pkt land on this thread too), faulting with "Stack overflow"
# on ENETQOS_RX. 2048 covers normal operations; debug builds take more in
# debug.conf.
config ETH_NXP_ENET_QOS_RX_THREAD_STACK_SIZE
	default 2048

# ZVFS_POLL_MAX must be strictly greater than the number of services
# registered on the socket-service thread: DNS_RESOLVER registers one and
# MDNS_RESPONDER two. Zephyr's default of 3 has no headroom for them, so the
# service thread fails at boot and every socket it owns is unread.
config ZVFS_POLL_MAX
	default 6 if DNS_RESOLVER || MDNS_RESPONDER

# Budgets for the network stack's tables. Zephyr's small defaults (6 network
# contexts, 8 connections, and a zero-based fd table that rounds up only to
# the subsystem adders) are exhausted by the DNS resolver's sockets, the
# web-workflow listener and the connection manager's socket pool together:
# socket creation then fails ("Out of sockets"), getaddrinfo() cannot hand its
# query to the resolver (reported as DNS_EAI_SYSTEM, "getaddrinfo failure:
# -11"), and Zephyr's socket service can walk freed table entries and fault.
# Each closed TCP connection holds a slot for TIME_WAIT, so the headroom also
# keeps web workflow bursts from being refused. 12, as on the boards that
# documented this before the default existed.
config NET_MAX_CONTEXTS
	default 12 if NETWORKING

config NET_MAX_CONN
	default 12 if NETWORKING

config ZVFS_OPEN_MAX
	default 12 if NETWORKING

# The per-interface TX/RX queue threads run the full network stack plus its
# logs; Zephyr's 1200/1500-1792 baselines overflow when the debug packet
# tracing lands on those threads, faulting rx_q[...] with "Stack overflow".
config NET_TX_STACK_SIZE
	default 3072 if NETWORKING

config NET_RX_STACK_SIZE
	default 3072 if NETWORKING

# The net_mgmt event thread runs interface/wifi/ethernet management callbacks
# (carrier, address add, DHCP bind...) — including their logging. Zephyr's 800
# byte default overflows on those events.
config NET_MGMT_EVENT_STACK_SIZE
	default 2048 if NETWORKING

# ... and the socket-service thread, whose poll() set includes the DNS
# resolver's UDP sockets; its 1200 byte default overflows under DBG logs.
config NET_SOCKETS_SERVICE_STACK_SIZE
	default 2400 if NETWORKING

# ... and the TCP workqueue, which runs the whole TCP input path (segment
# processing, retransmit timers and the net_tcp DBG logs) on its own thread;
# Zephyr's 1024 default overflows under TCP DBG logging.
config NET_TCP_WORKQ_STACK_SIZE
	default 2400 if NETWORKING

# The mbedtls TLS configuration needed by shared-module/ssl (protocol, key
# exchange, RNG and PEM parsing). It applies to every board with a network
# interface (wifi, ethernet or offloaded sockets) because Zephyr's mbedtls
# build is fully Kconfig-driven: without PEM parsing, for example,
# shared-bindings/ssl cannot load PEM CAs. Boards can disable it with
# CONFIG_ZCP_MBEDTLS_TLS=n in their board.conf.
config ZCP_MBEDTLS_TLS
	bool "mbedtls TLS support for the ssl module"
	default y if WIFI || NET_L2_ETHERNET || NET_NATIVE_OFFLOADED_SOCKETS
	# Client-side TLS as required by shared-module/ssl: TLS 1.2 with the
	# ECDHE-RSA key exchange, X.509 certificates and PEM parsing. Selecting
	# Zephyr's MBEDTLS_CIPHERSUITE_* config instead would also force RSA-PSS
	# and RSA key-pair generation, which a TLS client never needs and which
	# don't fit flash-tight boards. A board can still
	# enable such cipher-suite extras in its board.conf.
	select MBEDTLS_SSL_PROTO_TLS1_2
	select MBEDTLS_X509_CRT_PARSE_C
	select MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED
	select MBEDTLS_PEM_PARSE_C
	# RNG: prefer the smaller external-RNG backend whenever the board has a
	# CSPRNG driver (Zephyr's default), and only select the legacy entropy +
	# CTR-DRBG path (several KB) on boards without one.
	select MBEDTLS_ENTROPY_C if !MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG
	select MBEDTLS_CTR_DRBG_C if !MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG

# The PSA crypto wants needed to verify real-world certificate chains: certs
# signed with SHA-384/512 (e.g. Sectigo "R"-series CAs) and ECDSA signatures,
# plus the curve/cipher selection matching ports/espressif/sdkconfig so web
# TLS behaves the same. Gated on ZCP_MBEDTLS_TLS rather than set in prj.conf:
# Zephyr compiles PSA code for every wanted algorithm, so on BLE-only boards
# (which still get PSA crypto from CONFIG_PSA_CRYPTO for BT) the unconditional
# wants would build RSA/ECC code paths that fail -Werror (unused-parameter in
# dead rsa.c wrappers) or, on silabs, trip the driver-only-builds
# "Unsupported partial support for ECC curves acceleration" check. Boards can
# still override any of these in board.conf to save flash.
config PSA_WANT_ALG_SHA_384
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ALG_SHA_512
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ALG_ECDSA
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ALG_GCM
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_SECP_R1_384
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_SECP_R1_521
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_SECP_K1_256
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_MONTGOMERY_255
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_BRAINPOOL_P_R1_256
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_BRAINPOOL_P_R1_384
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_BRAINPOOL_P_R1_512
	default y if ZCP_MBEDTLS_TLS

# What the ECDHE-RSA / TLS 1.2 handshake itself needs (the PSA wants the
# removed Zephyr cipher-suite select used to bring in). These are also plain
# defaults so flash-tight boards can drop, e.g., RSA-PSS or the RSA key-pair
# operations a TLS client never performs.
config PSA_WANT_ALG_TLS12_PRF
	default y if ZCP_MBEDTLS_TLS

# ECDHE key exchange needs ECDH; mbedtls_check_config.h rejects
# MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED without it (MBEDTLS_CAN_ECDH).
config PSA_WANT_ALG_ECDH
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ALG_HMAC
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ALG_CBC_NO_PADDING
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_KEY_TYPE_AES
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ALG_RSA_PKCS1V15_SIGN
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ALG_RSA_PSS
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_IMPORT
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE
	default y if ZCP_MBEDTLS_TLS

config PSA_WANT_ECC_SECP_R1_256
	default y if ZCP_MBEDTLS_TLS
# The BLE controller's "Assert on Prepare Latency" (lll_adv prepare_cb) halts
# the whole system with a kernel oops in the radio ISR when an ADV/connection
# event starts late. CircuitPython runs arbitrary user Python code, so the
# controller can never assume bounded CPU latency between events: a VM busy
# with GC, printing or a big allocation will occasionally push an event past
# its planned start (Zephyr GitHub issue #67868 fails exactly like this under
# CPU overheads). Defining the default here puts it before Zephyr's
# controller Kconfig, and Kconfig takes the first default, so late events are
# skipped gracefully instead of halting, as Zephyr's help text recommends.
# (The symbol resolves as promptless in this port's Kconfig tree - its
# visibility is 0 - so setting CONFIG_BT_CTLR_ASSERT_OVERHEAD_START=n in
# prj.conf/debug.conf is silently ignored, hence this defaults-module entry.)
config BT_CTLR_ASSERT_OVERHEAD_START
	default n

# ===== OTA firmware updates over BLE (SMP/MCUmgr) =====
#
# Boards that boot under MCUboot opt in via boards/<vendor>/<board>/sysbuild.conf
# setting CONFIG_BOOTLOADER_MCUBOOT, which sysbuild turns into an app-side
# CONFIG_BOOTLOADER_MCUBOOT. OTA is enabled when the app boots from slot0 under
# MCUboot and has Bluetooth; the app boots with the image upload in slot1.
#
# A slot1_partition must also exist in the final app devicetree: the mcuboot
# fork's partition layout overlays are applied there, so boards.toml-driven
# layouts count. Boards with a single-app layout (e.g. stm32wba65i_dk1,
# siwx917_dk2605a) have no slot1 to stage an upload in, and zephyr_img_mgmt
# fails to build without one, so MCUmgr defaults off for them automatically
# instead of needing a CONFIG_MCUMGR=n override in board.conf.
#
# Gating on BOOTLOADER_MCUBOOT (not just on a slot1_partition existing) keeps
# boards that link the app over the whole flash (e.g. nrf54lm20dk) from letting
# an upload erase the running image that happens to overlap slot1.

DT_HAS_SLOT1 := $(dt_nodelabel_enabled,slot1_partition)

config ZCBOR
	default y if BT && BOOTLOADER_MCUBOOT && $(DT_HAS_SLOT1)

config MCUMGR
	default y if BT && BOOTLOADER_MCUBOOT && $(DT_HAS_SLOT1)

config MCUMGR_TRANSPORT_BT
	default y if BT && BOOTLOADER_MCUBOOT

config MCUMGR_TRANSPORT_BT_REASSEMBLY
	default y if MCUMGR_TRANSPORT_BT

# Just Works pairing for the SMP service. The port registers no interactive
# pairing callbacks (no display/keyboard IO capability; numeric comparison
# raises NotImplementedError here), so MITM-authenticated pairing can never
# complete. Zephyr's defaults are the opposite (BT_SMP_ENFORCE_MITM=y and the
# PERM choice defaulting to MCUMGR_TRANSPORT_BT_PERM_RW_AUTHEN), which puts
# WRITE_AUTHEN on the SMP characteristics and makes every SMP write fail with
# insufficient authentication. Pair Just Works and require encryption only,
# per the OTA policy documented in the port README.
config BT_SMP_ENFORCE_MITM
	default n if BT && BOOTLOADER_MCUBOOT

# The default for the SMP service's GATT-permission choice. Zephyr's own
# default (subsys/mgmt/mcumgr/transport/Kconfig.bluetooth) is
# MCUMGR_TRANSPORT_BT_PERM_RW_AUTHEN, which puts WRITE_AUTHEN on the SMP
# characteristics and makes every SMP write fail with insufficient
# authentication. This module Kconfig is merged before Zephyr's subsystem
# Kconfigs, so this `default` (on the choice, not the symbol) wins. The
# choice itself is Zephyr's; only the default is added here.
choice MCUMGR_TRANSPORT_BT_PERM
	default MCUMGR_TRANSPORT_BT_PERM_RW_ENCRYPT if MCUMGR_TRANSPORT_BT
endchoice

# Request a fast connection interval while an upload is in progress.
config MCUMGR_TRANSPORT_BT_CONN_PARAM_CONTROL
	default y if MCUMGR_TRANSPORT_BT

config IMG_MANAGER
	default y if MCUMGR_TRANSPORT_BT

# IMG_MANAGER ("DFU image manager") depends on STREAM_FLASH, which has no
# default of its own, so enable it with the same gate as IMG_MANAGER.
config STREAM_FLASH
	default y if MCUMGR_TRANSPORT_BT

config MCUMGR_GRP_IMG
	default y if IMG_MANAGER

config MCUMGR_GRP_OS
	default y if MCUMGR_TRANSPORT_BT

# Let clients discover the SMP buffer count/size so they can use optimal
# upload chunking and window sizes (the nRF Connect Device Manager apps do
# this automatically).
config MCUMGR_GRP_OS_MCUMGR_PARAMS
	default y if MCUMGR_GRP_OS

# Fit a full ATT write (the port raises BT_L2CAP_TX_MTU to 515) plus the
# 8-byte MCUmgr BT overhead in each buffer, so one upload packet fills one
# buffer instead of needing reassembly.
config MCUMGR_TRANSPORT_NETBUF_SIZE
	default 528 if MCUMGR_TRANSPORT_BT

# Debug logging for the whole MCUmgr stack (OTA/SMP) cannot be defaulted
# from Kconfig source: the per-module log levels (CONFIG_..._LOG_LEVEL_DBG)
# are members of anonymous Kconfig choices, so neither `default` on the int
# nor `select` on a choice member overrides the built-in "Default" member.
# Instead, the OTA boards (the ones whose .config has CONFIG_MCUMGR=y,
# i.e. BT + MCUboot + slot1) set the assignments in their board.conf:
#
#   CONFIG_MCUMGR_LOG_LEVEL_DBG=y
#   CONFIG_MCUMGR_TRANSPORT_LOG_LEVEL_DBG=y
#   CONFIG_MCUMGR_GRP_IMG_LOG_LEVEL_DBG=y
#   CONFIG_MCUMGR_GRP_OS_LOG_LEVEL_DBG=y
#
# (In a board.conf the assignments are only valid while MCUmgr is enabled,
# which is exactly what the OTA gate guarantees there.) With
# CONFIG_LOG_MODE_IMMEDIATE the logs go straight out of the console backend
# (the board's console UART), interleaved with the CircuitPython output.

# ===== Resetting into the bootloader =====
#
# The app asks the installed bootloader for its update mode (the state a
# double-tap of the reset button produces) on reset_to_bootloader() and
# microcontroller.OnNextReset(RunMode.UF2 / RunMode.BOOTLOADER), via the
# adaboot fork's adaboot/update_mode.h helpers. Two bootloaders are in play:
#
# - The fork's adaboot (MCUboot) reads the boot-mode retention flag (io.c's
#   io_detect_boot_mode()), so the app needs the retained-memory chain
#   enabled; the flag region (zephyr,boot-mode, e.g. gpregret1) is provided
#   by the fork's dtsi, which sysbuild applies to the application image too.
#   Every board that boots via adaboot has a boot-mode region in its layout
#   (a GPREGRET register on the Nordic SoCs, a retained SRAM byte elsewhere).
# - The stock Adafruit nRF52 bootloader (the Adafruit boards, which boot UF2
#   with no MCUboot domain) reads the raw GPREGRET register instead, so no
#   retention subsystem is needed for them.

DT_BOOT_MODE_CHOSEN := zephyr,boot-mode
DT_BOOT_INFO_CHOSEN := zephyr,bootloader-info

config RETAINED_MEM
	default y if BOOTLOADER_MCUBOOT && ($(dt_chosen_enabled,$(DT_BOOT_MODE_CHOSEN)) || $(dt_chosen_enabled,$(DT_BOOT_INFO_CHOSEN)))

config RETENTION
	default y if RETAINED_MEM

config RETENTION_BOOT_MODE
	default y if RETENTION && $(dt_chosen_enabled,$(DT_BOOT_MODE_CHOSEN))

# Read the boot state (mode/running slot/version) the bootloader leaves in
# the zephyr,bootloader-info shared-data region, and teach Zephyr's SMP
# bootloader-info command the fork's identity: without a hook, the
# application-side handler reports the hardcoded "MCUboot" and derives the
# mode from the app's own Kconfig. The hook answers in
# supervisor/adaboot_info.c.
config RETENTION_BOOTLOADER_INFO
	default y if BOOTLOADER_MCUBOOT && $(dt_chosen_enabled,$(DT_BOOT_INFO_CHOSEN))

config RETENTION_BOOTLOADER_INFO_TYPE_MCUBOOT
	default y if RETENTION_BOOTLOADER_INFO

config MCUMGR_MGMT_NOTIFICATION_HOOKS
	default y if MCUMGR && RETENTION_BOOTLOADER_INFO_TYPE_MCUBOOT

config MCUMGR_GRP_OS_BOOTLOADER_INFO
	default y if MCUMGR

config MCUMGR_GRP_OS_BOOTLOADER_INFO_HOOK
	default y if MCUMGR_MGMT_NOTIFICATION_HOOKS
